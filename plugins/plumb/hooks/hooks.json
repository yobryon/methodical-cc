{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/compaction.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/orient.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/orient.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/orient.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/bus_sweep.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
